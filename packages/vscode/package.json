{
  "name": "archpilot-studio",
  "displayName": "ArchPilot",
  "description": "Executable architecture guardrails and AI-readiness auditor for VS Code, Cursor, and Windsurf",
  "version": "0.8.0",
  "publisher": "Pallattu",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacob-git/archpilot.git"
  },
  "bugs": {
    "url": "https://github.com/jacob-git/archpilot/issues"
  },
  "homepage": "https://github.com/jacob-git/archpilot#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "agents.md",
    "ai-ready",
    "architecture",
    "guardrails",
    "boundaries",
    "cursor",
    "claude",
    "mcp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "ArchPilot",
      "properties": {
        "archpilot.costPerMillionInputTokens": {
          "type": "number",
          "default": 3,
          "description": "Input token price in USD per 1M tokens used for monthly cost estimates (e.g., 0.30 for Flash/Mini, 3 for Sonnet/GPT-4o, 15 for Opus)."
        },
        "archpilot.modelPresetLabel": {
          "type": "string",
          "default": "Standard ($3/1M)",
          "description": "Display label for the selected model pricing tier."
        },
        "archpilot.npmAuditRegistry": {
          "type": "string",
          "default": "",
          "description": "Optional npm registry URL for dependency CVE audits (e.g., https://registry.npmjs.org). Leave empty to use your default registry with automatic fallback to public npmjs.org."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "archpilot",
          "title": "ArchPilot",
          "icon": "media/archpilot.svg"
        }
      ]
    },
    "views": {
      "archpilot": [
        {
          "id": "archpilot.auditView",
          "name": "Audit Report"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "archpilot.auditView",
        "contents": "Open a workspace folder to run ArchPilot architecture and AI-readiness checks.\n[Refresh Audit](command:archpilot.refresh)"
      }
    ],
    "commands": [
      {
        "command": "archpilot.refresh",
        "title": "Refresh Audit",
        "category": "ArchPilot",
        "icon": "$(refresh)"
      },
      {
        "command": "archpilot.rescanProject",
        "title": "Rescan Repository",
        "category": "ArchPilot",
        "icon": "$(refresh)"
      },
      {
        "command": "archpilot.generateAgentsMd",
        "title": "Generate AGENTS.md",
        "category": "ArchPilot",
        "icon": "$(new-file)"
      },
      {
        "command": "archpilot.initConfig",
        "title": "Initialize archpilot.json",
        "category": "ArchPilot",
        "icon": "$(gear)"
      },
      {
        "command": "archpilot.autoFixProject",
        "title": "Auto-Fix Deterministic Issues",
        "category": "ArchPilot",
        "icon": "$(wrench)"
      },
      {
        "command": "archpilot.copyFixPrompt",
        "title": "Copy Fix Prompt for AI Agent",
        "category": "ArchPilot",
        "icon": "$(sparkle)"
      },
      {
        "command": "archpilot.copyBadge",
        "title": "Copy README Badge",
        "category": "ArchPilot",
        "icon": "$(bookmark)"
      },
      {
        "command": "archpilot.quickFixFinding",
        "title": "Quick Fix",
        "category": "ArchPilot",
        "icon": "$(wrench)"
      },
      {
        "command": "archpilot.ignoreFindingFile",
        "title": "Ignore File in archpilot.json",
        "category": "ArchPilot",
        "icon": "$(eye-closed)"
      },
      {
        "command": "archpilot.addToAiIgnore",
        "title": "Add File to .aiignore (Save Agent Tokens)",
        "category": "ArchPilot",
        "icon": "$(filter)"
      },
      {
        "command": "archpilot.selectModelPreset",
        "title": "Select Model Pricing Preset",
        "category": "ArchPilot",
        "icon": "$(credit-card)"
      },
      {
        "command": "archpilot.optimizeTokenCost",
        "title": "Reduce AI Token Cost (Exclude Large Files)",
        "category": "ArchPilot",
        "icon": "$(zap)"
      },
      {
        "command": "archpilot.generateArchMap",
        "title": "Generate ARCHMAP.md (Compact Repo Map)",
        "category": "ArchPilot",
        "icon": "$(map)"
      },
      {
        "command": "archpilot.openGraph",
        "title": "Open Architecture Graph",
        "category": "ArchPilot",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "archpilot.checkBlastRadius",
        "title": "Check Git Diff & Blast Radius",
        "category": "ArchPilot",
        "icon": "$(git-compare)"
      },
      {
        "command": "archpilot.fixWithAiChat",
        "title": "Fix with AI Chat",
        "category": "ArchPilot",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "archpilot.exportHtmlReport",
        "title": "Export Executive Report (HTML)",
        "category": "ArchPilot",
        "icon": "$(export)"
      },
      {
        "command": "archpilot.generateArchitectureMd",
        "title": "Generate ARCHITECTURE.md (Mermaid Diagram)",
        "category": "ArchPilot",
        "icon": "$(graph)"
      },
      {
        "command": "archpilot.generatePrBrief",
        "title": "Generate PR & QA Handoff Brief",
        "category": "ArchPilot",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "archpilot.auditDependencies",
        "title": "Audit Dependency Vulnerabilities (CVEs)",
        "category": "ArchPilot",
        "icon": "$(shield)"
      },
      {
        "command": "archpilot.planMigration",
        "title": "Plan Upgrade / Migration...",
        "category": "ArchPilot",
        "icon": "$(rocket)"
      }
    ],
    "submenus": [
      {
        "id": "archpilot.explorerMenu",
        "label": "ArchPilot",
        "icon": "$(shield)"
      },
      {
        "id": "archpilot.audit",
        "label": "Audit"
      },
      {
        "id": "archpilot.optimize",
        "label": "Optimize"
      },
      {
        "id": "archpilot.generateExport",
        "label": "Generate & Export"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "archpilot.explorerMenu",
          "when": "explorerResourceIsRoot",
          "group": "7_modification@10"
        }
      ],
      "archpilot.explorerMenu": [
        {
          "command": "archpilot.optimizeTokenCost",
          "group": "0_fix@1"
        },
        {
          "command": "archpilot.autoFixProject",
          "group": "0_fix@2"
        },
        {
          "command": "archpilot.fixWithAiChat",
          "group": "0_fix@3"
        },
        {
          "command": "archpilot.openGraph",
          "group": "1_primary@1"
        },
        {
          "command": "archpilot.rescanProject",
          "group": "1_primary@2"
        },
        {
          "submenu": "archpilot.audit",
          "group": "2_groups@1"
        },
        {
          "submenu": "archpilot.optimize",
          "group": "2_groups@2"
        },
        {
          "submenu": "archpilot.generateExport",
          "group": "2_groups@3"
        }
      ],
      "view/title": [
        {
          "command": "archpilot.refresh",
          "when": "view == archpilot.auditView",
          "group": "navigation@1"
        },
        {
          "command": "archpilot.openGraph",
          "when": "view == archpilot.auditView",
          "group": "navigation@2"
        },
        {
          "command": "archpilot.checkBlastRadius",
          "when": "view == archpilot.auditView",
          "group": "1_audit@1"
        },
        {
          "command": "archpilot.auditDependencies",
          "when": "view == archpilot.auditView",
          "group": "1_audit@2"
        },
        {
          "command": "archpilot.generateAgentsMd",
          "when": "view == archpilot.auditView",
          "group": "2_setup@1"
        },
        {
          "command": "archpilot.initConfig",
          "when": "view == archpilot.auditView",
          "group": "2_setup@2"
        },
        {
          "command": "archpilot.selectModelPreset",
          "when": "view == archpilot.auditView",
          "group": "3_settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "archpilot.optimizeTokenCost",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project.*\\.sinks(\\b|$)/",
          "group": "0_fix@1"
        },
        {
          "command": "archpilot.autoFixProject",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project.*\\.autofix(\\b|$)/",
          "group": "0_fix@2"
        },
        {
          "command": "archpilot.fixWithAiChat",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project.*\\.issues(\\b|$)/",
          "group": "0_fix@3"
        },
        {
          "command": "archpilot.openGraph",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project(\\b|$)/",
          "group": "1_primary@1"
        },
        {
          "command": "archpilot.rescanProject",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project(\\b|$)/",
          "group": "1_primary@2"
        },
        {
          "submenu": "archpilot.audit",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project(\\b|$)/",
          "group": "2_groups@1"
        },
        {
          "submenu": "archpilot.optimize",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project(\\b|$)/",
          "group": "2_groups@2"
        },
        {
          "submenu": "archpilot.generateExport",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.project(\\b|$)/",
          "group": "2_groups@3"
        },
        {
          "command": "archpilot.fixWithAiChat",
          "when": "view == archpilot.auditView && viewItem == archpilot.category.issues",
          "group": "0_fix@1"
        },
        {
          "command": "archpilot.copyFixPrompt",
          "when": "view == archpilot.auditView && viewItem == archpilot.category.issues",
          "group": "0_fix@2"
        },
        {
          "command": "archpilot.quickFixFinding",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.finding.*\\.fixable(\\b|$)/",
          "group": "0_fix@1"
        },
        {
          "command": "archpilot.fixWithAiChat",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.finding(\\b|$)/",
          "group": "0_fix@2"
        },
        {
          "command": "archpilot.copyFixPrompt",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.finding(\\b|$)/",
          "group": "0_fix@3"
        },
        {
          "command": "archpilot.addToAiIgnore",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.finding.*\\.bloat(\\b|$)/",
          "group": "1_ignore@1"
        },
        {
          "command": "archpilot.ignoreFindingFile",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.finding.*\\.ignorable(\\b|$)/",
          "group": "1_ignore@2"
        },
        {
          "command": "archpilot.optimizeTokenCost",
          "when": "view == archpilot.auditView && viewItem == archpilot.tokenCost.hasSavings",
          "group": "0_fix@1"
        },
        {
          "command": "archpilot.selectModelPreset",
          "when": "view == archpilot.auditView && viewItem =~ /^archpilot\\.tokenCost/",
          "group": "1_pricing@1"
        }
      ],
      "archpilot.audit": [
        {
          "command": "archpilot.checkBlastRadius",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_audit@1"
        },
        {
          "command": "archpilot.auditDependencies",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_audit@2"
        },
        {
          "command": "archpilot.generatePrBrief",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_audit@3"
        },
        {
          "command": "archpilot.planMigration",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_audit@4"
        }
      ],
      "archpilot.optimize": [
        {
          "command": "archpilot.optimizeTokenCost",
          "when": "viewItem =~ /^archpilot\\.project.*\\.sinks(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_optimize@1"
        },
        {
          "command": "archpilot.copyFixPrompt",
          "when": "viewItem =~ /^archpilot\\.project.*\\.issues(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_optimize@2"
        },
        {
          "command": "archpilot.selectModelPreset",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "2_pricing@1"
        }
      ],
      "archpilot.generateExport": [
        {
          "command": "archpilot.generateAgentsMd",
          "when": "viewItem =~ /^archpilot\\.project.*\\.noAgents(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_setup@1"
        },
        {
          "command": "archpilot.initConfig",
          "when": "viewItem =~ /^archpilot\\.project.*\\.noConfig(\\b|$)/ || explorerResourceIsRoot",
          "group": "1_setup@2"
        },
        {
          "command": "archpilot.generateArchitectureMd",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "2_docs@1"
        },
        {
          "command": "archpilot.generateArchMap",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "2_docs@2"
        },
        {
          "command": "archpilot.exportHtmlReport",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "3_share@1"
        },
        {
          "command": "archpilot.copyBadge",
          "when": "viewItem =~ /^archpilot\\.project(\\b|$)/ || explorerResourceIsRoot",
          "group": "3_share@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archpilot/core": "0.8.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.5"
  }
}
